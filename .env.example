# One secret per agent, as agent:secret pairs. Generate each with: openssl rand -hex 32
LORE_TOKENS=claude:replace-with-a-long-random-secret,codex:replace-with-another-long-random-secret
# Or a single secret shared by every agent (can be combined with LORE_TOKENS).
# LORE_TOKEN=

# Password for the admin view at /admin. Leave empty to disable the view.
LORE_ADMIN_PASSWORD=

# Optional second password that signs in watch-only: the graph and the live
# activity, but no backup export, import or restore. Must differ from the one above.
LORE_VIEWER_PASSWORD=

# Recovery only: while on, LORE_ADMIN_PASSWORD signs in as admin even after the
# password was changed on the page, and without admin's second step. Turn it
# off again after recovering.
# LORE_ADMIN_BREAK_GLASS=off
# Passkeys are bound to the host lore is reached at; set a parent domain here
# only to share them across subdomains (must fit every LORE_ALLOWED_HOSTS entry).
# LORE_WEBAUTHN_RP_ID=
# The name authenticator apps show; default "lore (<host>)".
# LORE_TOTP_ISSUER=

# Google reCAPTCHA v3 keys for the admin sign-in. Leave both empty to skip it.
LORE_RECAPTCHA_SITE_KEY=
LORE_RECAPTCHA_SECRET_KEY=
# LORE_RECAPTCHA_MIN_SCORE=0.5

# Key the service credentials (Cloudflare, GitHub, GitLab, Dokploy) and the
# authenticator-app secrets of the admin sign-in are encrypted with: exactly 64 hex characters. Generate one with:
#   openssl rand -hex 32
# Leave empty to disable the credential vault: no credential can be stored
# and the agent tools that call those services say so. Keep a copy: losing
# the key means entering the credentials again.
LORE_VAULT_KEY=

# lore's own secrets (every token in LORE_TOKENS and LORE_TOKEN, both passwords,
# LORE_RECAPTCHA_SECRET_KEY and LORE_VAULT_KEY; values of 8 characters or more)
# are redacted from every provider response, so an agent reading lore's own
# Dokploy application never sees them.
# When lore itself runs on Dokploy: the ids of its own deployment (application,
# project, environment, domain, mount ids...), comma separated, each at least 8
# characters of A-Z a-z 0-9 _ -. Agents may still read them, but any non-GET
# Dokploy call naming one of them is refused. Every other Dokploy project stays
# fully usable. Full Dokploy access still means control of the host lore runs
# on: set agents that should not have that to read or off on the Integrations panel.
# LORE_DOKPLOY_PROTECTED=

# bge-m3 (default, best recall, about 2 GB RAM), e5-large, e5-base, e5-small (lightest)
# LORE_EMBEDDING_MODEL=bge-m3
# Set to off for keyword-only search with no model download.
# LORE_EMBEDDINGS=on

# Hours without activity after which an open agent session is closed
# automatically (whole number between 1 and 720).
# LORE_SESSION_IDLE_HOURS=12

# Language of the status texts ChatGPT shows while a lore tool runs:
# tr, en or off. Clients must refresh the connector after a change.
# LORE_TOOL_STATUS_LANG=tr

# Public hostnames allowed in the Host header. Empty accepts any.
# LORE_ALLOWED_HOSTS=lore.example.com

# Behind a reverse proxy (the image sets LORE_TRUST_PROXY=on), which peers'
# X-Forwarded-For lore believes. On Dokploy, name Traefik: lore resolves the
# name at start-up and every 30 seconds and follows its address when Traefik's
# container restarts.
# LORE_TRUSTED_PROXY_HOSTS=dokploy-traefik
# Or fixed address ranges, comma separated: your proxy's own address, never
# the subnet of a network other applications share (on Dokploy every
# application is on dokploy-network). Unset (both): any peer, as before, or
# with built-in agents any private or loopback peer outside the agent networks
# (with a warning at start-up).
# LORE_TRUSTED_PROXIES=127.0.0.1/32

# docker-compose.yml publishes no port (Dokploy reaches lore through Traefik).
# On a plain docker host, publish it on 127.0.0.1 only with the override file:
# COMPOSE_FILE=docker-compose.yml:docker-compose.local.yml
# LORE_PORT=8080

# Built-in coding agents: use docker-compose.agents.yml (COMPOSE_FILE below,
# or `docker compose -f docker-compose.agents.yml ...`; on Dokploy, as the
# compose path). With docker-compose.yml alone none of this is used and lore
# behaves exactly as without them. One runner secret per agent, each
# generated with: openssl rand -hex 32. lore reads LORE_RUNNER_TOKENS; each
# agent container gets only its own secret from the LORE_RUNNER_TOKEN_* line
# with the same value (compose passes it on; the agents never see this file).
# An agent whose name does not start with claude, codex or deepseek names its
# CLI: helper:opencode/qwen:<secret>.
# COMPOSE_FILE=docker-compose.agents.yml
# LORE_RUNNER_TOKENS=claude-builtin:<secret-1>,codex-builtin:<secret-2>,deepseek-builtin:<secret-3>
# LORE_RUNNER_TOKEN_CLAUDE=<secret-1>
# LORE_RUNNER_TOKEN_CODEX=<secret-2>
# LORE_RUNNER_TOKEN_DEEPSEEK=<secret-3>
# The agents' networks: one /28 each, a range inside it for everything but
# lore, and lore's fixed address (where the runner listener binds). Change
# them when they clash with a network on the host (see the README's check).
# LORE_AGENT_SUBNET_CLAUDE=172.31.250.0/28
# LORE_AGENT_RANGE_CLAUDE=172.31.250.8/29
# LORE_AGENT_IP_CLAUDE=172.31.250.2
# LORE_AGENT_SUBNET_CODEX=172.31.250.16/28
# LORE_AGENT_RANGE_CODEX=172.31.250.24/29
# LORE_AGENT_IP_CODEX=172.31.250.18
# LORE_AGENT_SUBNET_DEEPSEEK=172.31.250.32/28
# LORE_AGENT_RANGE_DEEPSEEK=172.31.250.40/29
# LORE_AGENT_IP_DEEPSEEK=172.31.250.34
# Where lore listens for the runners; by default lore's address on each
# agent network (from the three LORE_AGENT_IP_* above).
# LORE_RUNNER_BIND=172.31.250.2:8081,172.31.250.18:8081,172.31.250.34:8081
# The hosts a CLI's sign-in link may point to, should a CLI move its sign-in
# (comma separated; replaces the built-in list for that CLI).
# LORE_SIGN_IN_HOSTS_CLAUDE=claude.ai,claude.com,console.anthropic.com,platform.claude.com
# LORE_SIGN_IN_HOSTS_CODEX=auth.openai.com,chatgpt.com
# The egress proxy's allowlist (default: the model providers' API and sign-in
# hosts). Comma separated; .example.com allows every name under example.com.
# LORE_PROXY_ALLOW=
# Optional: an OpenAI API key for the Codex agent instead of the ChatGPT sign-in.
# Compose passes it to that agent only; lore's own environment gets it empty.
# LORE_AGENT_CODEX_API_KEY=
# Limits of each agent container. LORE_AGENT_WORK_EXEC=exec lets the agents run
# programs they build in a checkout (noexec by default).
# LORE_AGENT_CPUS=2
# LORE_AGENT_MEMORY=4g
# LORE_AGENT_WORK_SIZE=2g
# LORE_AGENT_WORK_EXEC=noexec
# The task runner: how many times one task is taken before it waits for its
# author or a signed-in user, and the most output lines kept per run.
# LORE_AUTO_TASK_MAX_ATTEMPTS=2
# LORE_RUN_OUTPUT_CAP_LINES=20000

# The docker volume that holds lore's data. compose never creates it: it must
# exist (docker volume create project-lore-data), so a typo can never start lore
# on an empty database. See "Moving a single-container install to compose" in the README.
# LORE_DATA_VOLUME=project-lore-data
