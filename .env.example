# One secret per agent, as agent:secret pairs. Generate each with: openssl rand -hex 32
LORE_TOKENS=claude:replace-with-a-long-random-secret,codex:replace-with-another-long-random-secret
# Or a single secret shared by every agent (can be combined with LORE_TOKENS).
# LORE_TOKEN=

# Password for the admin view at /admin. Leave empty to disable the view.
LORE_ADMIN_PASSWORD=

# Optional second password that signs in watch-only: the graph and the live
# activity, but no backup export, import or restore. Must differ from the one above.
LORE_VIEWER_PASSWORD=

# Google reCAPTCHA v3 keys for the admin sign-in. Leave both empty to skip it.
LORE_RECAPTCHA_SITE_KEY=
LORE_RECAPTCHA_SECRET_KEY=
# LORE_RECAPTCHA_MIN_SCORE=0.5

# bge-m3 (default, best recall, about 2 GB RAM), e5-large, e5-base, e5-small (lightest)
# LORE_EMBEDDING_MODEL=bge-m3
# Set to off for keyword-only search with no model download.
# LORE_EMBEDDINGS=on

# Hours without activity after which an open agent session is closed
# automatically (whole number between 1 and 720).
# LORE_SESSION_IDLE_HOURS=12

# Public hostnames allowed in the Host header. Empty accepts any.
# LORE_ALLOWED_HOSTS=lore.example.com

# Host port published by docker compose.
# LORE_PORT=8080
